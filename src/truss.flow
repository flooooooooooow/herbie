# @module herbie.truss
# Small-displacement 2D pin-jointed truss element, linear elastic.
# All inputs SI; caller-provided 16-element row-major stiffness buffer.

export struct TrussElement2D {
    x1: f64,
    y1: f64,
    x2: f64,
    y2: f64,
    crossSectionArea: f64,
    youngModulus: f64
}

export function truss2DLength(e: TrussElement2D) -> f64 {
    let dx: f64 = e.x2 - e.x1
    let dy: f64 = e.y2 - e.y1
    return sqrt(dx * dx + dy * dy)
}

export function truss2DStiffness(e: TrussElement2D, matrix: ptr<f64>) -> i32 {
    let length: f64 = truss2DLength(e)
    if length <= 0.0 or e.crossSectionArea <= 0.0 or e.youngModulus <= 0.0 {
        return 0
    }
    let c: f64 = (e.x2 - e.x1) / length
    let s: f64 = (e.y2 - e.y1) / length
    let factor: f64 = e.youngModulus * e.crossSectionArea / length
    let a: f64 = factor * c * c
    let b: f64 = factor * c * s
    let d: f64 = factor * s * s

    matrix[0] = a
    matrix[1] = b
    matrix[2] = -a
    matrix[3] = -b

    matrix[4] = b
    matrix[5] = d
    matrix[6] = -b
    matrix[7] = -d

    matrix[8] = -a
    matrix[9] = -b
    matrix[10] = a
    matrix[11] = b

    matrix[12] = -b
    matrix[13] = -d
    matrix[14] = b
    matrix[15] = d
    return 1
}

export function truss2DExtension(e: TrussElement2D, ux1: f64, uy1: f64, ux2: f64, uy2: f64) -> f64 {
    let length: f64 = truss2DLength(e)
    let c: f64 = (e.x2 - e.x1) / length
    let s: f64 = (e.y2 - e.y1) / length
    return c * (ux2 - ux1) + s * (uy2 - uy1)
}

export function truss2DAxialForce(e: TrussElement2D, ux1: f64, uy1: f64, ux2: f64, uy2: f64) -> f64 {
    return e.youngModulus * e.crossSectionArea / truss2DLength(e)
        * truss2DExtension(e, ux1, uy1, ux2, uy2)
}

export function truss2DEnergy(e: TrussElement2D, ux1: f64, uy1: f64, ux2: f64, uy2: f64) -> f64 {
    let extension: f64 = truss2DExtension(e, ux1, uy1, ux2, uy2)
    return 0.5 * e.youngModulus * e.crossSectionArea / truss2DLength(e) * extension * extension
}

# @module herbie.deadtime
# Compatibility module. The inverter leg dead-time and device-drop model now lives in
# herbie.pwm next to the carrier compare it shares; this module re-exports it so
# existing imports of herbie.deadtime keep working unchanged.

export import herbie.pwm {
    LegDevices, DeadTimeTiming, deadTimeTimingOk, legDevicesOk, legSwitchDrop, legDiodeDrop,
    deadTimeAveragePoleVoltage, deadTimePoleVoltageAt, deadTimeCompensatedDuty, deadTimePhaseVoltages
}

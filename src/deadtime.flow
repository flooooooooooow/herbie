# @module herbie.deadtime
# Inverter leg non-idealities: gate dead time and device voltage drops for a two-level
# leg under centre-aligned PWM, as a switched sub-step model and as an exact
# period-average model, plus the inverse (duty compensation).
#
# Leg convention: pole voltage is measured from the DC-link negative rail; leg current
# i > 0 flows out of the pole into the load. Each turn-on is delayed by the dead time td,
# so per carrier period the upper switch conducts for max(0, d·Ts − td) and the lower
# switch for max(0, (1 − d)·Ts − td). Whenever the commanded switch cannot carry the
# current, or both gates are off, the anti-parallel diode set by the current sign
# conducts: i > 0 → lower diode (pole = −Vf), i < 0 → upper diode (pole = Vdc + Vf).
# Switch drop Vce = V0 + r·|i|; diode drop Vf = Vf0 + rf·|i|. The current is taken as
# constant over one carrier period, and i = 0 is treated with the i > 0 branch
# (zero-current clamping is not modelled).

import herbie.drive { ClarkeABC }

export struct LegDevices {
    switchThreshold: f64,
    switchResistance: f64,
    diodeThreshold: f64,
    diodeResistance: f64
}

export struct DeadTimeTiming {
    dcLinkVoltage: f64,
    carrierHz: f64,
    deadTime: f64
}

function dtAbs(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }
    return x
}

function dtMax0(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0
    }
    return x
}

export function deadTimeTimingOk(t: DeadTimeTiming) -> bool {
    return t.dcLinkVoltage > 0.0 and t.carrierHz > 0.0 and t.deadTime >= 0.0 and t.deadTime * t.carrierHz < 0.5
}

export function legDevicesOk(d: LegDevices) -> bool {
    return d.switchThreshold >= 0.0 and d.switchResistance >= 0.0 and d.diodeThreshold >= 0.0 and d.diodeResistance >= 0.0
}

export function legSwitchDrop(d: LegDevices, current: f64) -> f64 {
    return d.switchThreshold + d.switchResistance * dtAbs(current)
}

export function legDiodeDrop(d: LegDevices, current: f64) -> f64 {
    return d.diodeThreshold + d.diodeResistance * dtAbs(current)
}

# Exact period-average pole voltage for constant current with dead time and drops.
export function deadTimeAveragePoleVoltage(duty: f64, current: f64, t: DeadTimeTiming, dev: LegDevices) -> f64 {
    if not deadTimeTimingOk(t) or not legDevicesOk(dev) or duty < 0.0 or duty > 1.0 {
        return 0.0 / 0.0
    }
    let tau: f64 = t.deadTime * t.carrierHz
    let mut upper: f64 = dtMax0(duty - tau)
    let mut lower: f64 = dtMax0(1.0 - duty - tau)
    # No switching edges at 0 % or 100 % duty, so no dead time.
    if duty <= 0.0 {
        upper = 0.0
        lower = 1.0
    }
    if duty >= 1.0 {
        upper = 1.0
        lower = 0.0
    }
    let vce: f64 = legSwitchDrop(dev, current)
    let vf: f64 = legDiodeDrop(dev, current)
    let vdc: f64 = t.dcLinkVoltage
    if current >= 0.0 {
        # Upper switch for `upper`, lower diode for the rest of the period.
        return upper * (vdc - vce) - (1.0 - upper) * vf
    }
    # Lower switch for `lower`, upper diode for the rest of the period.
    return lower * vce + (1.0 - lower) * (vdc + vf)
}

# Switched pole voltage at plant sub-step `subStep` of `stepsPerPeriod`, with the dead
# time expressed as `deadSteps` whole sub-steps. The ideal centre-aligned on interval is
# the set of sub-steps whose carrier |2(k + ½)/N − 1| lies below the duty, matching
# herbie.pwm's carrier compare.
export function deadTimePoleVoltageAt(
    duty: f64,
    current: f64,
    dcLinkVoltage: f64,
    dev: LegDevices,
    subStep: i32,
    stepsPerPeriod: i32,
    deadSteps: i32
) -> f64 {
    if stepsPerPeriod <= 0 or deadSteps < 0 or 2 * deadSteps >= stepsPerPeriod {
        return 0.0 / 0.0
    }
    let n: i32 = stepsPerPeriod
    let k: i32 = subStep % n
    # Ideal on interval [kOn, kOff) from the centred carrier compare.
    let mut kOn: i32 = n
    let mut kOff: i32 = n
    for j in 0 to n {
        let phase: f64 = ((j as f64) + 0.5) / (n as f64)
        let mut c: f64 = 2.0 * phase - 1.0
        if c < 0.0 {
            c = -c
        }
        if duty > c {
            if kOn == n {
                kOn = j
            }
            kOff = j + 1
        }
    }
    let mut upperOn: bool = false
    let mut lowerOn: bool = false
    if kOn < n {
        upperOn = k >= kOn + deadSteps and k < kOff
        # Lower is ideally on outside [kOn, kOff) and turns on deadSteps after kOff.
        let insideIdeal: bool = k >= kOn and k < kOff
        let blankAfterOff: bool = (k >= kOff and k < kOff + deadSteps) or k < kOff + deadSteps - n
        lowerOn = not insideIdeal and not blankAfterOff
        if kOn == 0 and kOff == n {
            upperOn = true
            lowerOn = false
        }
    } else {
        lowerOn = true
    }
    let vce: f64 = legSwitchDrop(dev, current)
    let vf: f64 = legDiodeDrop(dev, current)
    if current >= 0.0 {
        if upperOn {
            return dcLinkVoltage - vce
        }
        return -vf
    }
    if lowerOn {
        return vce
    }
    return dcLinkVoltage + vf
}

# Duty that makes the average pole voltage equal targetDuty·Vdc for the given current.
# Exact inverse of deadTimeAveragePoleVoltage while no pulse is dropped; the result is
# clamped to [τ, 1 − τ] (τ = td·f) and NaN is returned for invalid inputs.
export function deadTimeCompensatedDuty(targetDuty: f64, current: f64, t: DeadTimeTiming, dev: LegDevices) -> f64 {
    if not deadTimeTimingOk(t) or not legDevicesOk(dev) {
        return 0.0 / 0.0
    }
    let tau: f64 = t.deadTime * t.carrierHz
    let vce: f64 = legSwitchDrop(dev, current)
    let vf: f64 = legDiodeDrop(dev, current)
    let vdc: f64 = t.dcLinkVoltage
    let mut d: f64 = 0.0
    if current >= 0.0 {
        d = tau + (targetDuty * vdc + vf) / (vdc - vce + vf)
    } else {
        d = (targetDuty * vdc - vce) / (vdc + vf - vce) - tau
    }
    if d < tau {
        return tau
    }
    if d > 1.0 - tau {
        return 1.0 - tau
    }
    return d
}

# Load phase voltages of a balanced star load from the three pole voltages.
export function deadTimePhaseVoltages(poleA: f64, poleB: f64, poleC: f64) -> ClarkeABC {
    let common: f64 = (poleA + poleB + poleC) / 3.0
    return ClarkeABC { a: poleA - common, b: poleB - common, c: poleC - common }
}

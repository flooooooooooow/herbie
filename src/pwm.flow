# @module herbie.pwm
# Two-level three-phase voltage-source inverter: carrier-based SVPWM duties (min-max
# zero-sequence injection), centre-aligned triangular carrier comparison, the eight
# switching states and switched pole-to-phase voltages, plus a control/PWM/plant
# timebase gate. The switched model is the counterpart of herbie.drive's averaged
# inverter: over one carrier period its phase volt-seconds equal the commanded average.
# The second part models one leg's gate dead time and device voltage drops (folded in
# from herbie.deadtime, which re-exports it). Conduction/switching losses and DC-link
# ripple are out of scope; the DC link is an ideal stiff source.

import herbie.drive { ClarkeABC, AlphaBeta, clarkeAlphaBetaToAbc }

export struct PhaseDuties {
    a: f64,
    b: f64,
    c: f64,
    # True when the request exceeded the linear SVPWM hexagon and a duty was clamped.
    saturated: bool
}

export struct PhaseSwitches {
    # true = upper device on (pole at +Vdc), false = lower device on (pole at 0).
    a: bool,
    b: bool,
    c: bool
}

export struct PwmTimebase {
    controlHz: f64,
    carrierHz: f64,
    plantHz: f64,
    # Plant sub-steps per carrier period and carrier periods per control update.
    stepsPerCarrier: i32,
    carriersPerControl: i32,
    # 0 ok; 1 non-positive rate; 2 carrier not an integer multiple of control;
    # 3 plant not an integer multiple of carrier; 4 fewer than 20 plant steps per carrier.
    fault: i32
}

function pwmClamp01(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0
    }
    if x > 1.0 {
        return 1.0
    }
    return x
}

function pwmMax3(a: f64, b: f64, c: f64) -> f64 {
    let mut m: f64 = a
    if b > m {
        m = b
    }
    if c > m {
        m = c
    }
    return m
}

function pwmMin3(a: f64, b: f64, c: f64) -> f64 {
    let mut m: f64 = a
    if b < m {
        m = b
    }
    if c < m {
        m = c
    }
    return m
}

function pwmRatio(num: f64, den: f64) -> i32 {
    let r: f64 = num / den
    let k: i32 = (r + 0.5) as i32
    let back: f64 = (k as f64) * den
    let tol: f64 = 1.0e-9 * num
    if k < 1 or back < num - tol or back > num + tol {
        return 0
    }
    return k
}

# Carrier SVPWM: phase references from inverse Clarke, common-mode offset −(max+min)/2,
# duty = ½ + v/Vdc. Linear for |v_αβ| ≤ Vdc/√3 (the inscribed circle of the hexagon).
export function svpwmDuties(reference: AlphaBeta, dcLinkVoltage: f64) -> PhaseDuties {
    if dcLinkVoltage <= 0.0 {
        return PhaseDuties { a: 0.0 / 0.0, b: 0.0 / 0.0, c: 0.0 / 0.0, saturated: true }
    }
    let abc: ClarkeABC = clarkeAlphaBetaToAbc(reference)
    let offset: f64 = -0.5 * (pwmMax3(abc.a, abc.b, abc.c) + pwmMin3(abc.a, abc.b, abc.c))
    let da: f64 = 0.5 + (abc.a + offset) / dcLinkVoltage
    let db: f64 = 0.5 + (abc.b + offset) / dcLinkVoltage
    let dc: f64 = 0.5 + (abc.c + offset) / dcLinkVoltage
    let tol: f64 = 1.0e-12
    let sat: bool = da < -tol or da > 1.0 + tol or db < -tol or db > 1.0 + tol or dc < -tol or dc > 1.0 + tol
    return PhaseDuties { a: pwmClamp01(da), b: pwmClamp01(db), c: pwmClamp01(dc), saturated: sat }
}

# Centre-aligned triangular carrier in [0, 1], sampled at the midpoint of plant sub-step
# `subStep` (0-based, wrapped) of `stepsPerPeriod`. Comparing duty > carrier yields an on
# interval centred in the period whose length is the duty quantised to 1/stepsPerPeriod.
export function pwmCarrierAt(subStep: i32, stepsPerPeriod: i32) -> f64 {
    if stepsPerPeriod <= 0 {
        return 0.0 / 0.0
    }
    let k: i32 = subStep % stepsPerPeriod
    let phase: f64 = ((k as f64) + 0.5) / (stepsPerPeriod as f64)
    let x: f64 = 2.0 * phase - 1.0
    if x < 0.0 {
        return -x
    }
    return x
}

export function pwmCompare(duties: PhaseDuties, carrier: f64) -> PhaseSwitches {
    return PhaseSwitches { a: duties.a > carrier, b: duties.b > carrier, c: duties.c > carrier }
}

# Switching state index 0..7 with bit0 = phase a, bit1 = b, bit2 = c (0 and 7 are zero vectors).
export function pwmSwitchState(index: i32) -> PhaseSwitches {
    return PhaseSwitches { a: index % 2 == 1, b: (index / 2) % 2 == 1, c: (index / 4) % 2 == 1 }
}

# Load phase-to-neutral voltages of a balanced star load (isolated neutral):
# v_an = Vdc (2Sa − Sb − Sc)/3 and cyclically.
export function pwmPhaseVoltages(sw: PhaseSwitches, dcLinkVoltage: f64) -> ClarkeABC {
    let mut sa: f64 = 0.0
    let mut sb: f64 = 0.0
    let mut sc: f64 = 0.0
    if sw.a {
        sa = 1.0
    }
    if sw.b {
        sb = 1.0
    }
    if sw.c {
        sc = 1.0
    }
    let k: f64 = dcLinkVoltage / 3.0
    return ClarkeABC {
        a: k * (2.0 * sa - sb - sc),
        b: k * (2.0 * sb - sa - sc),
        c: k * (2.0 * sc - sa - sb)
    }
}

# Instantaneous DC-link current drawn by the bridge: i_dc = Sa·ia + Sb·ib + Sc·ic.
export function pwmDcLinkCurrent(sw: PhaseSwitches, phaseCurrents: ClarkeABC) -> f64 {
    let mut i: f64 = 0.0
    if sw.a {
        i = i + phaseCurrents.a
    }
    if sw.b {
        i = i + phaseCurrents.b
    }
    if sw.c {
        i = i + phaseCurrents.c
    }
    return i
}

# Control updates must land on carrier period boundaries and the plant must resolve the
# carrier: carrierHz = n·controlHz and plantHz = m·carrierHz with integer n ≥ 1, m ≥ 20.
export function pwmTimebase(controlHz: f64, carrierHz: f64, plantHz: f64) -> PwmTimebase {
    if controlHz <= 0.0 or carrierHz <= 0.0 or plantHz <= 0.0 {
        return PwmTimebase {
            controlHz: controlHz, carrierHz: carrierHz, plantHz: plantHz,
            stepsPerCarrier: 0, carriersPerControl: 0, fault: 1
        }
    }
    let n: i32 = pwmRatio(carrierHz, controlHz)
    if n == 0 {
        return PwmTimebase {
            controlHz: controlHz, carrierHz: carrierHz, plantHz: plantHz,
            stepsPerCarrier: 0, carriersPerControl: 0, fault: 2
        }
    }
    let m: i32 = pwmRatio(plantHz, carrierHz)
    if m == 0 {
        return PwmTimebase {
            controlHz: controlHz, carrierHz: carrierHz, plantHz: plantHz,
            stepsPerCarrier: 0, carriersPerControl: n, fault: 3
        }
    }
    if m < 20 {
        return PwmTimebase {
            controlHz: controlHz, carrierHz: carrierHz, plantHz: plantHz,
            stepsPerCarrier: m, carriersPerControl: n, fault: 4
        }
    }
    return PwmTimebase {
        controlHz: controlHz, carrierHz: carrierHz, plantHz: plantHz,
        stepsPerCarrier: m, carriersPerControl: n, fault: 0
    }
}

# Dead time and device drops
#
# Inverter leg non-idealities: gate dead time and device voltage drops for a two-level
# leg under centre-aligned PWM, as a switched sub-step model and as an exact
# period-average model, plus the inverse (duty compensation).
#
# Leg convention: pole voltage is measured from the DC-link negative rail; leg current
# i > 0 flows out of the pole into the load. Each turn-on is delayed by the dead time td,
# so per carrier period the upper switch conducts for max(0, d·Ts − td) and the lower
# switch for max(0, (1 − d)·Ts − td). Whenever the commanded switch cannot carry the
# current, or both gates are off, the anti-parallel diode set by the current sign
# conducts: i > 0 → lower diode (pole = −Vf), i < 0 → upper diode (pole = Vdc + Vf).
# Switch drop Vce = V0 + r·|i|; diode drop Vf = Vf0 + rf·|i|. The current is taken as
# constant over one carrier period, and i = 0 is treated with the i > 0 branch
# (zero-current clamping is not modelled).

export struct LegDevices {
    switchThreshold: f64,
    switchResistance: f64,
    diodeThreshold: f64,
    diodeResistance: f64
}

export struct DeadTimeTiming {
    dcLinkVoltage: f64,
    carrierHz: f64,
    deadTime: f64
}

function dtAbs(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }
    return x
}

function dtMax0(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0
    }
    return x
}

export function deadTimeTimingOk(t: DeadTimeTiming) -> bool {
    return t.dcLinkVoltage > 0.0 and t.carrierHz > 0.0 and t.deadTime >= 0.0 and t.deadTime * t.carrierHz < 0.5
}

export function legDevicesOk(d: LegDevices) -> bool {
    return d.switchThreshold >= 0.0 and d.switchResistance >= 0.0 and d.diodeThreshold >= 0.0 and d.diodeResistance >= 0.0
}

export function legSwitchDrop(d: LegDevices, current: f64) -> f64 {
    return d.switchThreshold + d.switchResistance * dtAbs(current)
}

export function legDiodeDrop(d: LegDevices, current: f64) -> f64 {
    return d.diodeThreshold + d.diodeResistance * dtAbs(current)
}

# Exact period-average pole voltage for constant current with dead time and drops.
export function deadTimeAveragePoleVoltage(duty: f64, current: f64, t: DeadTimeTiming, dev: LegDevices) -> f64 {
    if not deadTimeTimingOk(t) or not legDevicesOk(dev) or duty < 0.0 or duty > 1.0 {
        return 0.0 / 0.0
    }
    let tau: f64 = t.deadTime * t.carrierHz
    let mut upper: f64 = dtMax0(duty - tau)
    let mut lower: f64 = dtMax0(1.0 - duty - tau)
    # No switching edges at 0 % or 100 % duty, so no dead time.
    if duty <= 0.0 {
        upper = 0.0
        lower = 1.0
    }
    if duty >= 1.0 {
        upper = 1.0
        lower = 0.0
    }
    let vce: f64 = legSwitchDrop(dev, current)
    let vf: f64 = legDiodeDrop(dev, current)
    let vdc: f64 = t.dcLinkVoltage
    if current >= 0.0 {
        # Upper switch for `upper`, lower diode for the rest of the period.
        return upper * (vdc - vce) - (1.0 - upper) * vf
    }
    # Lower switch for `lower`, upper diode for the rest of the period.
    return lower * vce + (1.0 - lower) * (vdc + vf)
}

# Switched pole voltage at plant sub-step `subStep` of `stepsPerPeriod`, with the dead
# time expressed as `deadSteps` whole sub-steps. The ideal centre-aligned on interval is
# the set of sub-steps whose carrier pwmCarrierAt(k, N) lies below the duty, the same
# compare as pwmCompare.
export function deadTimePoleVoltageAt(
    duty: f64,
    current: f64,
    dcLinkVoltage: f64,
    dev: LegDevices,
    subStep: i32,
    stepsPerPeriod: i32,
    deadSteps: i32
) -> f64 {
    if stepsPerPeriod <= 0 or deadSteps < 0 or 2 * deadSteps >= stepsPerPeriod {
        return 0.0 / 0.0
    }
    let n: i32 = stepsPerPeriod
    let k: i32 = subStep % n
    # Ideal on interval [kOn, kOff) from the centred carrier compare.
    let mut kOn: i32 = n
    let mut kOff: i32 = n
    for j in 0 to n {
        if duty > pwmCarrierAt(j, n) {
            if kOn == n {
                kOn = j
            }
            kOff = j + 1
        }
    }
    let mut upperOn: bool = false
    let mut lowerOn: bool = false
    if kOn < n {
        upperOn = k >= kOn + deadSteps and k < kOff
        # Lower is ideally on outside [kOn, kOff) and turns on deadSteps after kOff.
        let insideIdeal: bool = k >= kOn and k < kOff
        let blankAfterOff: bool = (k >= kOff and k < kOff + deadSteps) or k < kOff + deadSteps - n
        lowerOn = not insideIdeal and not blankAfterOff
        if kOn == 0 and kOff == n {
            upperOn = true
            lowerOn = false
        }
    } else {
        lowerOn = true
    }
    let vce: f64 = legSwitchDrop(dev, current)
    let vf: f64 = legDiodeDrop(dev, current)
    if current >= 0.0 {
        if upperOn {
            return dcLinkVoltage - vce
        }
        return -vf
    }
    if lowerOn {
        return vce
    }
    return dcLinkVoltage + vf
}

# Duty that makes the average pole voltage equal targetDuty·Vdc for the given current.
# Exact inverse of deadTimeAveragePoleVoltage while no pulse is dropped; the result is
# clamped to [τ, 1 − τ] (τ = td·f) and NaN is returned for invalid inputs.
export function deadTimeCompensatedDuty(targetDuty: f64, current: f64, t: DeadTimeTiming, dev: LegDevices) -> f64 {
    if not deadTimeTimingOk(t) or not legDevicesOk(dev) {
        return 0.0 / 0.0
    }
    let tau: f64 = t.deadTime * t.carrierHz
    let vce: f64 = legSwitchDrop(dev, current)
    let vf: f64 = legDiodeDrop(dev, current)
    let vdc: f64 = t.dcLinkVoltage
    let mut d: f64 = 0.0
    if current >= 0.0 {
        d = tau + (targetDuty * vdc + vf) / (vdc - vce + vf)
    } else {
        d = (targetDuty * vdc - vce) / (vdc + vf - vce) - tau
    }
    if d < tau {
        return tau
    }
    if d > 1.0 - tau {
        return 1.0 - tau
    }
    return d
}

# Load phase voltages of a balanced star load from the three pole voltages.
export function deadTimePhaseVoltages(poleA: f64, poleB: f64, poleC: f64) -> ClarkeABC {
    let common: f64 = (poleA + poleB + poleC) / 3.0
    return ClarkeABC { a: poleA - common, b: poleB - common, c: poleC - common }
}

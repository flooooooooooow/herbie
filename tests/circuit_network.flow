import herbie.circuits { CircuitNetwork, circuitClear, circuitStampResistor, circuitStampCurrentSource, circuitSolve, circuitMaxKclResidual }

function near(actual: f64, expected: f64, tolerance: f64) -> bool {
    return actual >= expected - tolerance and actual <= expected + tolerance
}

function main() -> i32 {
    let mut matrix: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut rhs: array<f64, 2> = [0.0, 0.0]
    let mut scratchMatrix: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut scratchRhs: array<f64, 2> = [0.0, 0.0]
    let mut voltage: array<f64, 2> = [0.0, 0.0]
    let n: CircuitNetwork = CircuitNetwork {
        nodeCount: 2,
        conductance: &matrix[0],
        injectedCurrent: &rhs[0]
    }
    circuitClear(n)
    if not circuitStampResistor(n, 0, -1, 1000.0) {
        return 1
    }
    if not circuitStampResistor(n, 0, 1, 1000.0) {
        return 2
    }
    if not circuitStampResistor(n, 1, -1, 1000.0) {
        return 3
    }
    if not circuitStampCurrentSource(n, -1, 0, 0.01) {
        return 4
    }
    if circuitStampResistor(n, 0, 0, 1000.0) {
        return 5
    }
    if circuitStampResistor(n, -2, 0, 1000.0) {
        return 6
    }
    if circuitStampResistor(n, 0, -1, 0.0) {
        return 7
    }
    if not circuitSolve(n, &voltage[0], &scratchMatrix[0], &scratchRhs[0], 1.0e-12) {
        println("FAIL resistive network solve")
        return 8
    }
    if not near(voltage[0], 6.666666666666667, 1.0e-9) {
        println("FAIL resistive network first node")
        return 9
    }
    if not near(voltage[1], 3.3333333333333335, 1.0e-9) {
        println("FAIL resistive network second node")
        return 10
    }
    if circuitMaxKclResidual(n, &voltage[0]) > 1.0e-12 {
        println("FAIL KCL residual")
        return 11
    }
    let sourcePower: f64 = 0.01 * voltage[0]
    let loss0: f64 = voltage[0] * voltage[0] / 1000.0
    let delta: f64 = voltage[0] - voltage[1]
    let loss1: f64 = delta * delta / 1000.0
    let loss2: f64 = voltage[1] * voltage[1] / 1000.0
    if not near(sourcePower, loss0 + loss1 + loss2, 1.0e-12) {
        println("FAIL DC network power balance")
        return 12
    }
    if not near(matrix[0], 0.002, 1.0e-12) or not near(rhs[0], 0.01, 1.0e-12) {
        println("FAIL circuitSolve changed inputs")
        return 13
    }
    circuitClear(n)
    if not circuitStampResistor(n, 0, 1, 1000.0) {
        return 14
    }
    if circuitSolve(n, &voltage[0], &scratchMatrix[0], &scratchRhs[0], 1.0e-12) {
        println("FAIL floating circuit was not rejected")
        return 15
    }
    println("PASS nodal circuit analytical, conservation and singularity checks")
    return 0
}

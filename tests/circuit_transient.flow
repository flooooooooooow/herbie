import herbie.transient { TransientElement, transientReset, transientResistor, transientCapacitor, transientInductor, transientVoltageSource, transientCurrentSource, transientInitialize, transientSetSource, transientStep, transientVoltage, transientCurrent, transientStatus, transientTime }

let mut elements: array<TransientElement, 4> = [TransientElement { kind: 0, a: 0, b: 0, value: 0.0, previous: 0.0 }, TransientElement { kind: 0, a: 0, b: 0, value: 0.0, previous: 0.0 }, TransientElement { kind: 0, a: 0, b: 0, value: 0.0, previous: 0.0 }, TransientElement { kind: 0, a: 0, b: 0, value: 0.0, previous: 0.0 }]

extern {
    function printf(fmt: string, value: f64) -> i32
}

function absolute(x: f64) -> f64 {
    if x < 0.0 { return -x }
    return x
}

function runFirstOrder(rl: bool, stepsPerTau: i32) -> f64 {
    let h: f64 = 0.001 / (stepsPerTau as f64)
    if not transientReset(2, h, &elements[0], 4) { return -1.0 }
    let source: i32 = transientVoltageSource(0, -1, 0.0)
    let mut reactive: i32 = -1
    if rl {
        if transientResistor(0, 1, 100.0) < 0 { return -1.0 }
        reactive = transientInductor(1, -1, 0.1)
    } else {
        if transientResistor(0, 1, 1000.0) < 0 { return -1.0 }
        reactive = transientCapacitor(1, -1, 1e-6)
    }
    if source < 0 or reactive < 0 or not transientInitialize() { return -1.0 }
    if not transientSetSource(source, 1.0) { return -1.0 }
    let mut discrete: f64 = 0.0
    let mut error: f64 = 0.0
    for n in 0 to stepsPerTau * 5 {
        if not transientStep() { println("FAIL physical residual or solve")
            return -1.0 }
        discrete = (discrete + h / 0.001) / (1.0 + h / 0.001)
        let mut measured: f64 = transientVoltage(1)
        if rl { measured = transientCurrent(reactive) * 100.0 }
        if absolute(measured - discrete) > 1e-10 { return -1.0 }
        let exact: f64 = 1.0 - exp(-((n + 1) as f64) * h / 0.001)
        let difference: f64 = absolute(measured - exact)
        if difference > error { error = difference }
    }
    if absolute(transientTime() - 0.005) > 1e-14 { return -1.0 }
    if not transientSetSource(source, 0.0) { return -1.0 }
    let mut oldEnergy: f64 = discrete * discrete
    for n in 0 to stepsPerTau {
        if not transientStep() { return -1.0 }
        discrete = discrete / (1.0 + h / 0.001)
        let mut measured: f64 = transientVoltage(1)
        if rl { measured = transientCurrent(reactive) * 100.0 }
        if absolute(measured - discrete) > 1e-10 or measured * measured > oldEnergy { return -1.0 }
        oldEnergy = measured * measured
    }
    return error
}

function runRlc(h: f64, steps: i32) -> f64 {
    if not transientReset(3, h, &elements[0], 4) { return -1.0 }
    let source: i32 = transientVoltageSource(0, -1, 0.0)
    if transientResistor(0, 1, 100.0) < 0 { return -1.0 }
    let ind: i32 = transientInductor(1, 2, 0.1)
    if transientCapacitor(2, -1, 1e-6) < 0 or ind < 0 or source < 0 { return -1.0 }
    if not transientInitialize() or not transientSetSource(source, 1.0) { return -1.0 }
    let wd: f64 = sqrt(1.0 / (0.1 * 1e-6) - 500.0 * 500.0)
    let mut worst: f64 = 0.0
    let mut oldV: f64 = 0.0
    let mut oldI: f64 = 0.0
    for n in 0 to steps {
        if not transientStep() { return -1.0 }
        let v: f64 = transientVoltage(2)
        let i: f64 = transientCurrent(ind)
        let t: f64 = ((n + 1) as f64) * h
        let exactV: f64 = 1.0 - exp(-500.0 * t) * (cos(wd * t) + 500.0 / wd * sin(wd * t))
        let exactI: f64 = exp(-500.0 * t) * sin(wd * t) / (0.1 * wd)
        let ev: f64 = absolute(v - exactV)
        let ei: f64 = absolute(i - exactI) / 0.01
        if ev > worst { worst = ev }
        if ei > worst { worst = ei }
        let deltaE: f64 = 0.5e-6 * (v * v - oldV * oldV) + 0.05 * (i * i - oldI * oldI)
        let numericalLoss: f64 = 0.5e-6 * (v - oldV) * (v - oldV) + 0.05 * (i - oldI) * (i - oldI)
        let delivered: f64 = -transientCurrent(source) * h
        if absolute(delivered - h * 100.0 * i * i - deltaE - numericalLoss) > 1e-14 { return -1.0 }
        oldV = v
        oldI = i
    }
    return worst
}

function main() -> i32 {
    for kind in 0 to 2 {
        let e1: f64 = runFirstOrder(kind == 1, 100)
        let e2: f64 = runFirstOrder(kind == 1, 200)
        let e3: f64 = runFirstOrder(kind == 1, 400)
        printf("first-order finest normalized error: %.12g\n", e3)
        if e1 <= 0.0 or e2 <= 0.0 or e3 <= 0.0 or e3 > 1e-3 { return 1 }
        if e1 / e2 < 1.87 or e1 / e2 > 2.14 or e2 / e3 < 1.87 or e2 / e3 > 2.14 { return 2 }
    }
    if transientReset(2, 0.0, &elements[0], 4) { return 3 }
    if not transientReset(2, 1e-6, &elements[0], 4) { return 4 }
    if transientStep() or transientResistor(0, -1, -1.0) >= 0
        or transientResistor(2, -1, 1.0) >= 0 { return 5 }
    # Floating DC network must fail without gmin.
    if transientResistor(0, 1, 1000.0) < 0 { return 6 }
    if transientInitialize() or transientStatus() == 0 { return 7 }
    # Contradictory ideal sources.
    if not transientReset(1, 1e-6, &elements[0], 4) { return 8 }
    if transientVoltageSource(0, -1, 1.0) < 0 or transientVoltageSource(0, -1, 2.0) < 0 { return 9 }
    if transientInitialize() { return 10 }
    if not transientReset(2, 1e-6, &elements[0], 4) { return 13 }
    let supply: i32 = transientVoltageSource(0, -1, 12.0)
    if transientResistor(0, 1, 1000.0) < 0 or transientResistor(1, -1, 1000.0) < 0 { return 14 }
    if transientCurrentSource(-1, 1, 0.001) < 0 or not transientInitialize() { return 15 }
    if absolute(transientVoltage(1) - 6.5) > 1e-10 or absolute(transientCurrent(supply) + 0.0055) > 1e-12 { return 16 }
    if transientResistor(0, -1, 1000.0) >= 0 or transientSetSource(1, 2.0) { return 17 }
    if not transientReset(1, 1e-6, &elements[0], 1) { return 18 }
    let infinity: f64 = exp(1000.0)
    if transientResistor(0, -1, infinity) >= 0 or transientVoltageSource(0, -1, infinity - infinity) >= 0 { return 19 }
    if transientResistor(0, -1, 1000.0) < 0 or transientResistor(0, -1, 1000.0) >= 0 { return 20 }
    if not transientInitialize() { return 21 }
    let r1: f64 = runRlc(1e-6, 5000)
    let r2: f64 = runRlc(5e-7, 10000)
    let r3: f64 = runRlc(2.5e-7, 20000)
    printf("RLC finest normalized error: %.12g\n", r3)
    if r1 <= 0.0 or r2 <= 0.0 or r3 <= 0.0 or r3 > 1e-3 { return 11 }
    if r1 / r2 < 1.87 or r1 / r2 > 2.14 or r2 / r3 < 1.87 or r2 / r3 > 2.14 { return 12 }
    println("PASS RLC trace, energy balance and first-order convergence")
    println("PASS RC/RL discrete recurrence, analytic traces, first-order convergence and invalid networks")
    return 0
}

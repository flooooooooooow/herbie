# Seeded Monte Carlo stack, Pp/Ppk and SPC gates against analytic references.

import herbie.stackups { LinearToleranceStack, LinearStackResult, stackEvaluate }
import herbie.montecarlo {
    MonteCarloConfig, MonteCarloResult, SpcXbarLimits,
    mcConfigOk, mcStackSample, mcSummarize, mcSeed,
    processPp, processPpk, spcXbarLimits, mcPercentile
}

function near(a: f64, b: f64, eps: f64) -> bool {
    return a >= b - eps and a <= b + eps
}

function absf(x: f64) -> f64 {
    if x < 0.0 { return -x }
    return x
}

function testConfigAndSeed() -> i32 {
    if mcConfigOk(MonteCarloConfig { samples: 8, seed: 1, distribution: 0 }) {
        return 1
    }
    if mcConfigOk(MonteCarloConfig { samples: 100, seed: 0, distribution: 0 }) {
        return 2
    }
    if not mcConfigOk(MonteCarloConfig { samples: 100, seed: 42, distribution: 2 }) {
        return 3
    }
    if mcSeed(0) {
        return 4
    }
    return 0
}

function testIndependentGaussianMatchesRss() -> i32 {
    # Clearance = hole - shaft; σ_h=30µm, σ_s=20µm independent → σ=√(0.00003²+0.00002²)
    let mut nominal: array<f64, 2> = [0.020, 0.0199]
    let mut half: array<f64, 2> = [0.00005, 0.00002]
    let mut coef: array<f64, 2> = [1.0, -1.0]
    let mut cov: array<f64, 4> = [9.0e-10, 0.0, 0.0, 4.0e-10]
    let mut factor: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut work: array<f64, 2> = [0.0, 0.0]
    let n: i32 = 4000
    let mut samples: array<f64, 4000> = [0.0; 4000]
    let mut scratch: array<f64, 4000> = [0.0; 4000]
    let stack: LinearToleranceStack = LinearToleranceStack {
        count: 2, nominal: &nominal[0], halfWidths: &half[0],
        coefficients: &coef[0], covariance: &cov[0]
    }
    let config: MonteCarloConfig = MonteCarloConfig {
        samples: n, seed: 0xC0FFEE42 as u32, distribution: 0
    }
    if not mcStackSample(stack, config, &factor[0], &samples[0], &work[0]) {
        return 1
    }
    let mut out: MonteCarloResult = MonteCarloResult {
        mean: 0.0, variance: 0.0, sigma: 0.0, minimum: 0.0, maximum: 0.0,
        percentileLow: 0.0, percentileHigh: 0.0, samplesUsed: 0
    }
    if not mcSummarize(&samples[0], n, 0.025, 0.975, &scratch[0], &out) {
        return 2
    }
    let expectedMean: f64 = 0.0001
    let expectedSigma: f64 = sqrt(1.3e-9)
    if absf(out.mean - expectedMean) > 8.0e-7 {
        println("FAIL MC independent mean")
        return 3
    }
    if absf(out.sigma - expectedSigma) > 8.0e-7 {
        println("FAIL MC independent sigma")
        return 4
    }
    # Empirical 95% interval should sit near ±1.96 σ of the mean for large N.
    let z: f64 = 1.96 * expectedSigma
    if absf((out.percentileHigh - out.mean) - z) > 3.0e-6 {
        println("FAIL MC upper percentile")
        return 5
    }
    if absf((out.mean - out.percentileLow) - z) > 3.0e-6 {
        println("FAIL MC lower percentile")
        return 6
    }
    return 0
}

function testCorrelatedMatchesAnalyticSigma() -> i32 {
    let mut nominal: array<f64, 2> = [0.020, 0.0199]
    let mut half: array<f64, 2> = [0.00005, 0.00002]
    let mut coef: array<f64, 2> = [1.0, -1.0]
    # Perfect positive correlation: clearance σ = |30-20| µm = 10 µm
    let mut cov: array<f64, 4> = [9.0e-10, 6.0e-10, 6.0e-10, 4.0e-10]
    let mut factor: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut work: array<f64, 2> = [0.0, 0.0]
    let mut evalScratch: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let n: i32 = 5000
    let mut samples: array<f64, 5000> = [0.0; 5000]
    let mut scratch: array<f64, 5000> = [0.0; 5000]
    let stack: LinearToleranceStack = LinearToleranceStack {
        count: 2, nominal: &nominal[0], halfWidths: &half[0],
        coefficients: &coef[0], covariance: &cov[0]
    }
    let mut analytic: LinearStackResult = LinearStackResult {
        nominal: 0.0, minimum: 0.0, maximum: 0.0,
        variance: 0.0, sigma: 0.0, largestWorstCaseContributor: -1
    }
    if not stackEvaluate(stack, &analytic, &evalScratch[0], 1.0e-12) {
        return 1
    }
    let config: MonteCarloConfig = MonteCarloConfig {
        samples: n, seed: 123456789 as u32, distribution: 1
    }
    if not mcStackSample(stack, config, &factor[0], &samples[0], &work[0]) {
        return 2
    }
    let mut out: MonteCarloResult = MonteCarloResult {
        mean: 0.0, variance: 0.0, sigma: 0.0, minimum: 0.0, maximum: 0.0,
        percentileLow: 0.0, percentileHigh: 0.0, samplesUsed: 0
    }
    if not mcSummarize(&samples[0], n, 0.025, 0.975, &scratch[0], &out) {
        return 3
    }
    if absf(out.sigma - analytic.sigma) > 5.0e-7 {
        println("FAIL correlated MC vs analytic sigma")
        return 4
    }
    if absf(out.mean - analytic.nominal) > 5.0e-7 {
        return 5
    }
    return 0
}

function testUniformBoundedAndSeedReplay() -> i32 {
    let mut nominal: array<f64, 2> = [0.010, 0.004]
    let mut half: array<f64, 2> = [0.00002, 0.00001]
    let mut coef: array<f64, 2> = [1.0, 1.0]
    let mut cov: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut factor: array<f64, 4> = [0.0, 0.0, 0.0, 0.0]
    let mut work: array<f64, 2> = [0.0, 0.0]
    let n: i32 = 2000
    let mut a: array<f64, 2000> = [0.0; 2000]
    let mut b: array<f64, 2000> = [0.0; 2000]
    let mut scratch: array<f64, 2000> = [0.0; 2000]
    let stack: LinearToleranceStack = LinearToleranceStack {
        count: 2, nominal: &nominal[0], halfWidths: &half[0],
        coefficients: &coef[0], covariance: &cov[0]
    }
    let config: MonteCarloConfig = MonteCarloConfig {
        samples: n, seed: 777, distribution: 2
    }
    if not mcStackSample(stack, config, &factor[0], &a[0], &work[0]) {
        return 1
    }
    if not mcStackSample(stack, config, &factor[0], &b[0], &work[0]) {
        return 2
    }
    for i in 0 to n {
        if a[i] != b[i] {
            println("FAIL seed replay")
            return 3
        }
    }
    let mut out: MonteCarloResult = MonteCarloResult {
        mean: 0.0, variance: 0.0, sigma: 0.0, minimum: 0.0, maximum: 0.0,
        percentileLow: 0.0, percentileHigh: 0.0, samplesUsed: 0
    }
    if not mcSummarize(&a[0], n, 0.0, 1.0, &scratch[0], &out) {
        return 4
    }
    let worstLo: f64 = 0.014 - 0.00003
    let worstHi: f64 = 0.014 + 0.00003
    if out.minimum < worstLo - 1.0e-15 or out.maximum > worstHi + 1.0e-15 {
        println("FAIL uniform outside worst-case")
        return 5
    }
    if absf(out.mean - 0.014) > 5.0e-7 {
        return 6
    }
    return 0
}

function testPpPpkAndSpc() -> i32 {
    # Synthetic: mean=10, sigma=1, LSL=7, USL=13 → Pp=1, Ppk=1
    let pp: f64 = processPp(1.0, 7.0, 13.0)
    let ppk: f64 = processPpk(10.0, 1.0, 7.0, 13.0)
    if not near(pp, 1.0, 1.0e-12) or not near(ppk, 1.0, 1.0e-12) {
        return 1
    }
    let ppkShift: f64 = processPpk(11.0, 1.0, 7.0, 13.0)
    if not near(ppkShift, 2.0 / 3.0, 1.0e-12) {
        return 2
    }
    # Five subgroups of size 4, all at 10.0; sigma=1 → half-width = 3/√4 = 1.5
    let mut meas: array<f64, 20> = [
        10.0, 10.0, 10.0, 10.0,
        10.0, 10.0, 10.0, 10.0,
        10.0, 10.0, 10.0, 10.0,
        10.0, 10.0, 10.0, 10.0,
        10.0, 10.0, 10.0, 10.0
    ]
    let mut limits: SpcXbarLimits = SpcXbarLimits {
        grandMean: 0.0, ucl: 0.0, lcl: 0.0, subgroupCount: 0, subgroupSize: 0
    }
    if not spcXbarLimits(&meas[0], 5, 4, 1.0, &limits) {
        return 3
    }
    if not near(limits.grandMean, 10.0, 1.0e-12)
        or not near(limits.ucl, 11.5, 1.0e-12)
        or not near(limits.lcl, 8.5, 1.0e-12) {
        println("FAIL SPC Xbar limits")
        return 4
    }
    return 0
}

function main() -> i32 {
    let a: i32 = testConfigAndSeed()
    if a != 0 {
        println("FAIL config/seed")
        return 10 + a
    }
    let b: i32 = testIndependentGaussianMatchesRss()
    if b != 0 {
        return 20 + b
    }
    let c: i32 = testCorrelatedMatchesAnalyticSigma()
    if c != 0 {
        return 30 + c
    }
    let d: i32 = testUniformBoundedAndSeedReplay()
    if d != 0 {
        return 40 + d
    }
    let e: i32 = testPpPpkAndSpc()
    if e != 0 {
        println("FAIL Pp/Ppk/SPC")
        return 50 + e
    }
    println("PASS monte carlo stacks, percentiles, Pp/Ppk and SPC limits")
    return 0
}
